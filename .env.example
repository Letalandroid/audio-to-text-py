# Configuración del Servidor
HOST=0.0.0.0
PORT=5000

# Configuración de Whisper
# Modelos disponibles: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
# Idioma forzado (ej: es); si se omite, se autodetecta
WHISPER_LANGUAGE=es
# Dispositivo: cpu o cuda
WHISPER_DEVICE=cpu
# Tipo de cómputo: int8 (recomendado para CPU), float16 (para GPU), float32
WHISPER_COMPUTE_TYPE=int8

# Tiempo de vida de trabajos asíncronos en memoria (segundos)
JOB_TTL_SECONDS=600

# Límite máximo de subida en MB
MAX_CONTENT_LENGTH_MB=200
